# /etc/testbed/testbed.env -- per-board collector configuration.
# install_services.sh writes a starter version; edit SYSCALL_CMD per board.
#
# Choose the syscall collector for THIS board (see record_device_meta.sh output):
#   RPi 5  (kernel 6.x, BTF)      : eBPF (BCC) -- lowest overhead, exact exec key
#   RPi 3B+(armhf 6.x)            : eBPF if BCC/bpftrace build, else perf
#   Jetson (L4T 4.9, no ringbuf)  : perf (raw_syscalls tracepoint) -- BCC often
#                                   will not build on the old kernel
#
# Uncomment exactly ONE SYSCALL_CMD:

# --- RPi 5 / any board where BCC works ---
SYSCALL_CMD=/usr/bin/python3 /opt/testbed/collectors/syscall/syscall_ebpf_collector.py --out /var/log/testbed/syscall --rotate-mb 128

# --- Jetson Nano / boards without BCC (perf fallback) ---
# SYSCALL_CMD=/opt/testbed/collectors/syscall/syscall_perf_capture.sh /var/log/testbed/syscall

TESTBED_ROOT=/opt/testbed
LOG_ROOT=/var/log/testbed
# where board logs are shipped (RPi 5 hub, or the Windows control box's sshd).
# Format: user@host:/path   (key-based SSH; see charter -- control has keys to boards,
# so for PUSH you provision a reverse key board->CONTROL, or use the PULL model
# log_puller.py on the control machine instead and leave CONTROL_TARGET blank.)
CONTROL_TARGET=
